<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:ui="clr-namespace:Content.Client.Shuttles.UI"
                      Title="{Loc 'medical-tracking-title'}"
                      SetSize="1100 820" MinSize="800 550">
    <BoxContainer Orientation="Horizontal">
        <ui:MapScreen Name="Map" HorizontalExpand="True" VerticalExpand="True" />
        <BoxContainer Orientation="Vertical" MinWidth="280" MaxWidth="350" Margin="8 0 0 0">
            <Label Text="{Loc 'medical-tracking-bodies'}" />
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="Contacts" Orientation="Vertical" />
            </ScrollContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
