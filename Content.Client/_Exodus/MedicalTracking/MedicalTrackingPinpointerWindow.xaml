<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'medical-tracking-pinpointer-title'}"
                      SetSize="400 450" MinSize="320 300">
    <BoxContainer Orientation="Vertical">
        <Label Text="{Loc 'medical-tracking-platinum'}" />
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="Brains" Orientation="Vertical" />
        </ScrollContainer>
        <Label Name="TargetLabel" />
        <BoxContainer Orientation="Horizontal">
            <SpriteView Name="Pointer" SetSize="64 64" Scale="2 2" />
            <Button Name="ClearTarget" Text="{Loc 'medical-tracking-clear'}" HorizontalExpand="True" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
